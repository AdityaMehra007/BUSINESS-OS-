<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Globe Meridian Ring -->
    <path
        android:pathData="M54,28 A26,26 0 1,0 54,80 A26,26 0 1,0 54,28 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#06B6D4" />

    <!-- Equatorial Ellipse Arc -->
    <path
        android:pathData="M28,54 A26,10 0 1,0 80,54 A26,10 0 1,0 28,54 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#38BDF8" />

    <!-- Vertical Meridian Ellipse Arc -->
    <path
        android:pathData="M54,28 A12,26 0 1,0 54,80 A12,26 0 1,0 54,28 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#38BDF8" />

    <!-- Orbital Diagonal Financial Swirl (Gold Accent) -->
    <path
        android:pathData="M32,70 C38,78 68,76 76,62 C84,48 76,34 62,32 C48,30 34,44 32,56"
        android:strokeWidth="2.2"
        android:strokeColor="#F59E0B"
        android:strokeLineCap="round" />

    <!-- Central Diamond Star Emblem with Linear Gradient -->
    <path
        android:pathData="M54,39 L59,51 L71,54 L59,57 L54,69 L49,57 L37,54 L49,51 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="39"
                android:endX="71"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#FBBF24" />
                <item android:offset="0.5" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core Nexus Dot -->
    <path
        android:pathData="M54,51 A3,3 0 1,0 54,57 A3,3 0 1,0 54,51 Z"
        android:fillColor="#FFFFFF" />

</vector>
