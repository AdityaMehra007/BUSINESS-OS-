rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.size() >= 5 &&
        data.userId == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.baseCurrency is string && data.baseCurrency.size() == 3 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // Validation for EntityRecord
    function isValidEntityRecord(data, userId) {
      return data.size() >= 8 &&
        data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.jurisdiction is string && data.jurisdiction.size() <= 100 &&
        data.countryCode is string && data.countryCode.size() == 2 &&
        data.status is string && data.status.size() <= 50 &&
        data.baseCurrency is string && data.baseCurrency.size() == 3 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // Validation for InvoiceRecord
    function isValidInvoiceRecord(data, userId) {
      return data.size() >= 9 &&
        data.userId == userId &&
        data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 50 &&
        data.issuingEntityName is string && data.issuingEntityName.size() <= 150 &&
        data.clientName is string && data.clientName.size() <= 150 &&
        data.amount is number && data.amount >= 0 &&
        data.currency is string && data.currency.size() == 3 &&
        data.status is string && (data.status in ['DRAFT', 'PENDING', 'IN_CLEARING', 'PAID', 'OVERDUE', 'DISPUTED']) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // Validation for FxBalanceRecord
    function isValidFxBalanceRecord(data, userId, currencyCode) {
      return data.size() >= 5 &&
        data.userId == userId &&
        data.currencyCode == currencyCode &&
        data.balance is number &&
        data.rateToUsd is number && data.rateToUsd >= 0 &&
        isValidTimestamp(data.updatedAt);
    }

    // User profile document rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      // Corporate Entities subcollection
      match /entities/{entityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEntityRecord(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidEntityRecord(request.resource.data, userId) &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // Cross-Border Invoices subcollection
      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidInvoiceRecord(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidInvoiceRecord(request.resource.data, userId) &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // Treasury FX Balances subcollection
      match /fx_balances/{currencyCode} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFxBalanceRecord(request.resource.data, userId, currencyCode);
        allow update: if isOwner(userId) && isValidFxBalanceRecord(request.resource.data, userId, currencyCode);
        allow delete: if isOwner(userId);
      }
    }
  }
}
